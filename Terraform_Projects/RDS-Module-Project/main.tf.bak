
#------------------- VPC module -------------------#
module "vpc" {
  source     = "./modules/vpc"
  cidr_block = var.cidr_block
  tags       = module.tags.common_tags
}

#------------------- tagging module -------------------#
module "tags" {
  source       = "./modules/tags"
  cost_centre  = "asd-123"
  owner        = "Mehrdad.Mokhtari1370@gmail.com"
  environment  = "dev"
  project_name = "rds-module"
}

#------------------- Netwroking module -------------------#
module "networking" {
  source   = "./modules/networking"
  vpc_id   = module.vpc.vpc_id
  vpc_cidr = module.vpc.vpc_cidr
  azs      = local.azs
  tags     = module.tags.common_tags
}
